# Illustrative local backend configuration; replace with your own values.
DATABASE_URL="postgresql://example_user:example_password@127.0.0.1:5432/example_database"
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
## Gere o segredo local com: pnpm --filter ./backend run configure:auth
## Em produção, forneça segredo aleatório próprio de pelo menos 32 bytes em base64url.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=neodireito
AUTH_JWT_AUDIENCE=neodireito-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
# Origem exata do frontend, sem barra final; em produção, HTTPS obrigatório.
# Se acessar por 127.0.0.1, configure http://127.0.0.1:5173 no ambiente.
AUTH_FRONTEND_ORIGIN=http://localhost:5173
# Limites compartilhados no PostgreSQL; mesmas configurações e segredo em todas as réplicas.
RATE_LIMIT_ONBOARDING_MAX=10
RATE_LIMIT_ONBOARDING_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_IP_MAX=30
# Em produção, omita RATE_LIMIT_LOGIN_IP_MAX para usar 10, ou configure explicitamente.
RATE_LIMIT_LOGIN_IDENTITY_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000
# Opcional: segredo base64url de pelo menos 32 bytes. Omitido: chave derivada de AUTH_JWT_SECRET.
# RATE_LIMIT_HMAC_SECRET=gere_um_segredo_proprio_nao_versionado
# Vazio: proxy não confiável. Em produção, liste somente IPs/CIDRs dos proxies controlados.
TRUST_PROXY=

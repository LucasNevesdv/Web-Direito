{
  "name": "@legal-system/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "verify:office-repository": "tsx tests/integration/prisma-offices-repository.check.ts",
    "verify:onboarding": "tsx tests/integration/onboarding.check.ts",
    "configure:auth": "node scripts/configure-auth.mjs",
    "verify:auth-browser": "node tests/integration/authentication-browser.check.mjs",
    "verify:rate-limit": "node tests/integration/distributed-rate-limit.check.mjs",
    "verify:password-security": "node tests/integration/password-security.check.mjs",
    "verify:team": "node tests/integration/team-management.check.mjs",
    "verify:sessions": "node tests/integration/session-management.check.mjs",
    "verify:tasks-documents": "tsx tests/integration/tasks-documents.check.ts",
    "verify:clients": "tsx tests/integration/clients-management.check.ts",
    "verify:cases-processes": "tsx tests/integration/cases-processes.check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3",
    "@aws-sdk/lib-storage": "3",
    "@fastify/cookie": "11",
    "@fastify/multipart": "9",
    "@prisma/client": "^6.16.2",
    "argon2": "0.44.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.0.0",
    "jose": "6",
    "nodemailer": "^10.0.13",
    "resend": "^6.31.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "mailparser": "^3.9.32",
    "prisma": "^6.16.2",
    "smtp-server": "^3.19.16",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

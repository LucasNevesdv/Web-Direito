generator client {
  provider = "prisma-client-js"
}

model RateLimitBucket {
  scope       String   @db.VarChar(32)
  keyHash     String   @map("key_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([scope, keyHash, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfficeStatus {
  ACTIVE
  INACTIVE

  @@map("office_status")
}

model Office {
  id            String             @id @db.Uuid
  name          String             @db.VarChar(120)
  status        OfficeStatus       @default(ACTIVE)
  createdAt     DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @map("updated_at") @db.Timestamptz(3)
  memberships   Membership[]
  sessions      Session[]
  tasks         Task[]
  deadlines     JudicialDeadline[]
  notifications Notification[]
  documents     Document[]
  clients       Client[]
  clientContacts ClientContact[]
  clientTimelineEvents ClientTimelineEvent[]
  legalCases    LegalCase[]
  caseClients   CaseClient[]
  caseTeamMembers CaseTeamMember[]
  caseParties   CaseParty[]
  legalProcesses LegalProcess[]
  processMovements ProcessMovement[]
  caseTimelineEvents CaseTimelineEvent[]

  @@map("offices")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum MembershipRole {
  OWNER
  ADMIN
  LAWYER
  INTERN
  SECRETARY

  @@map("membership_role")
}

model User {
  id                   String                    @id @db.Uuid
  name                 String                    @db.VarChar(120)
  email                String                    @unique @db.VarChar(254)
  passwordHash         String                    @map("password_hash") @db.Text
  status               UserStatus                @default(ACTIVE)
  createdAt            DateTime                  @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                  @map("updated_at") @db.Timestamptz(3)
  memberships          Membership[]
  sessions             Session[]
  passwordRecoveries   PasswordRecovery[]
  recoveryEmailJobs    RecoveryEmailJob[]
  mustChangePassword   Boolean                   @default(false) @map("must_change_password")
  teamChanges          MembershipHistory[]
  officeSelections     OfficeSelection[]
  tasksResponsible     Task[]                    @relation("TaskResponsible")
  tasksReviewing       Task[]                    @relation("TaskReviewer")
  tasksCreated         Task[]                    @relation("TaskCreator")
  tasksCompleted       Task[]                    @relation("TaskCompletedBy")
  checklistDone        TaskChecklistItem[]
  taskChanges          TaskHistory[]
  deadlinesResponsible JudicialDeadline[]        @relation("DeadlineResponsible")
  deadlinesConfirmed   JudicialDeadline[]        @relation("DeadlineConfirmedBy")
  deadlinesCompleted   JudicialDeadline[]        @relation("DeadlineCompletedBy")
  deadlineChanges      JudicialDeadlineHistory[]
  notifications        Notification[]
  documentsCreated     Document[]                @relation("DocumentCreator")
  documentsInactivated Document[]                @relation("DocumentInactivatedBy")
  documentVersions     DocumentVersion[]
  documentEvents       DocumentEvent[]
  clientTimelineEvents ClientTimelineEvent[] @relation("ClientTimelineActor")
  processMovements     ProcessMovement[]     @relation("ProcessMovementActor")
  caseTimelineEvents   CaseTimelineEvent[]   @relation("CaseTimelineActor")

  @@map("users")
}

model PasswordRecovery {
  id            String             @id @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  tokenHash     String             @unique @map("token_hash") @db.Char(64)
  createdAt     DateTime           @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime?          @map("used_at") @db.Timestamptz(3)
  invalidatedAt DateTime?          @map("invalidated_at") @db.Timestamptz(3)
  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  emailJobs     RecoveryEmailJob[]

  @@index([userId])
  @@index([expiresAt])
  @@map("password_recoveries")
}

enum RecoveryEmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED

  @@map("recovery_email_status")
}

model RecoveryEmailJob {
  id            String              @id @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  recoveryId    String?             @map("recovery_id") @db.Uuid
  status        RecoveryEmailStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt      DateTime?           @map("locked_at") @db.Timestamptz(3)
  lockedUntil   DateTime?           @map("locked_until") @db.Timestamptz(3)
  leaseId       String?             @map("lease_id") @db.Uuid
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @map("updated_at") @db.Timestamptz(3)
  errorCode     String?             @map("error_code") @db.VarChar(40)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recovery      PasswordRecovery?   @relation(fields: [recoveryId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([status, updatedAt])
  @@index([userId])
  @@index([recoveryId])
  @@map("recovery_email_jobs")
}

model Membership {
  id          String              @id @db.Uuid
  officeId    String              @map("office_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  role        MembershipRole
  createdAt   DateTime            @map("created_at") @db.Timestamptz(3)
  office      Office              @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions    Session[]
  active      Boolean             @default(true)
  permissions String[]            @default([])
  version     Int                 @default(0)
  updatedAt   DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  history              MembershipHistory[]
  clientsResponsible  Client[]            @relation("ClientResponsibleMembership")
  casesResponsible    LegalCase[]         @relation("CaseResponsibleMembership")
  caseTeamMembers     CaseTeamMember[]

  @@unique([officeId, userId])
  @@index([userId])
  @@index([officeId, active, createdAt])
  @@map("memberships")
}

model Session {
  browser          String     @default("Desconhecido") @db.VarChar(64)
  device           String     @default("Desconhecido") @db.VarChar(64)
  maskedIp         String     @default("Indisponível") @map("masked_ip") @db.VarChar(64)
  lastActivityAt   DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  id               String     @id @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  activeOfficeId   String     @map("active_office_id") @db.Uuid
  refreshTokenHash String     @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime   @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @map("updated_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?  @map("last_used_at") @db.Timestamptz(3)
  restricted       Boolean    @default(false)
  user             User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  office           Office     @relation(fields: [activeOfficeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership       Membership @relation(fields: [activeOfficeId, userId], references: [officeId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt])
  @@index([activeOfficeId, userId, revokedAt])
  @@index([userId, createdAt])
  @@map("sessions")
}

model OfficeSelection {
  tokenHash     String    @id @map("token_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Uuid
  userUpdatedAt DateTime  @map("user_updated_at") @db.Timestamptz(3)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("office_selections")
}

model MembershipHistory {
  id           String     @id @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  actorId      String     @map("actor_id") @db.Uuid
  action       String     @db.VarChar(32)
  previous     Json?
  current      Json
  createdAt    DateTime   @map("created_at") @db.Timestamptz(3)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([membershipId, createdAt])
  @@map("membership_history")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

model Task {
  id              String              @id @db.Uuid
  officeId        String              @map("office_id") @db.Uuid
  title           String              @db.VarChar(200)
  description     String              @default("") @db.VarChar(4000)
  status          TaskStatus          @default(PENDING)
  priority        TaskPriority        @default(MEDIUM)
  responsibleId   String              @map("responsible_id") @db.Uuid
  reviewerId      String?             @map("reviewer_id") @db.Uuid
  creatorId       String              @map("creator_id") @db.Uuid
  internalDueDate DateTime?           @map("internal_due_date") @db.Date
  clientId        String?             @map("client_id") @db.Uuid
  caseId          String?             @map("case_id") @db.Uuid
  processId       String?             @map("process_id") @db.Uuid
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz(3)
  completedById   String?             @map("completed_by_id") @db.Uuid
  completionNote  String?             @map("completion_note") @db.VarChar(2000)
  version         Int                 @default(0)
  createdAt       DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @map("updated_at") @db.Timestamptz(3)
  office          Office              @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsible     User                @relation("TaskResponsible", fields: [responsibleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer        User?               @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator         User                @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completedBy     User?               @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checklist       TaskChecklistItem[]
  history         TaskHistory[]
  deadlines       JudicialDeadline[]
  notifications   Notification[]

  @@index([officeId, status, internalDueDate])
  @@index([officeId, responsibleId, status])
  @@map("tasks")
}

model TaskChecklistItem {
  id        String    @id @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  title     String    @db.VarChar(200)
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  doneById  String?   @map("done_by_id") @db.Uuid
  position  Int
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  doneBy    User?     @relation(fields: [doneById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId, position])
  @@map("task_checklist_items")
}

model TaskHistory {
  id        String   @id @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(40)
  previous  Json?
  current   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId, createdAt])
  @@map("task_history")
}

enum DeadlineSource {
  INTIMATION
  PUBLICATION
  SUMMONS
  ORDER
  HEARING
  OTHER

  @@map("deadline_source")
}

enum DeadlineStatus {
  PENDING
  FULFILLED
  CANCELED

  @@map("deadline_status")
}

model JudicialDeadline {
  id             String                    @id @db.Uuid
  officeId       String                    @map("office_id") @db.Uuid
  description    String                    @db.VarChar(500)
  dueDate        DateTime                  @map("due_date") @db.Date
  source         DeadlineSource
  sourceDetails  String                    @default("") @map("source_details") @db.VarChar(500)
  status         DeadlineStatus            @default(PENDING)
  responsibleId  String                    @map("responsible_id") @db.Uuid
  confirmedById  String                    @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime                  @map("confirmed_at") @db.Timestamptz(3)
  taskId         String?                   @map("task_id") @db.Uuid
  clientId       String?                   @map("client_id") @db.Uuid
  caseId         String?                   @map("case_id") @db.Uuid
  processId      String?                   @map("process_id") @db.Uuid
  completedAt    DateTime?                 @map("completed_at") @db.Timestamptz(3)
  completedById  String?                   @map("completed_by_id") @db.Uuid
  completionNote String?                   @map("completion_note") @db.VarChar(2000)
  version        Int                       @default(0)
  createdAt      DateTime                  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @map("updated_at") @db.Timestamptz(3)
  office         Office                    @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsible    User                      @relation("DeadlineResponsible", fields: [responsibleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  confirmedBy    User                      @relation("DeadlineConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completedBy    User?                     @relation("DeadlineCompletedBy", fields: [completedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task           Task?                     @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  history        JudicialDeadlineHistory[]
  notifications  Notification[]

  @@index([officeId, status, dueDate])
  @@index([taskId])
  @@map("judicial_deadlines")
}

model JudicialDeadlineHistory {
  id         String           @id @db.Uuid
  deadlineId String           @map("deadline_id") @db.Uuid
  actorId    String           @map("actor_id") @db.Uuid
  action     String           @db.VarChar(40)
  previous   Json?
  current    Json
  createdAt  DateTime         @map("created_at") @db.Timestamptz(3)
  deadline   JudicialDeadline @relation(fields: [deadlineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor      User             @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([deadlineId, createdAt])
  @@map("judicial_deadline_history")
}

enum NotificationKind {
  TASK_DUE_SOON
  TASK_OVERDUE
  DEADLINE_CRITICAL
  DEADLINE_OVERDUE

  @@map("notification_kind")
}

enum NotificationEmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED

  @@map("notification_email_status")
}

model Notification {
  id            String                  @id @db.Uuid
  officeId      String                  @map("office_id") @db.Uuid
  userId        String                  @map("user_id") @db.Uuid
  kind          NotificationKind
  escalated     Boolean                 @default(false)
  taskId        String?                 @map("task_id") @db.Uuid
  deadlineId    String?                 @map("deadline_id") @db.Uuid
  targetId      String                  @map("target_id") @db.Uuid
  referenceDate DateTime                @map("reference_date") @db.Date
  title         String                  @db.VarChar(300)
  dueDate       DateTime                @map("due_date") @db.Date
  readAt        DateTime?               @map("read_at") @db.Timestamptz(3)
  emailStatus   NotificationEmailStatus @default(PENDING) @map("email_status")
  emailAttempts Int                     @default(0) @map("email_attempts")
  nextAttemptAt DateTime                @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?               @map("locked_until") @db.Timestamptz(3)
  leaseId       String?                 @map("lease_id") @db.Uuid
  sentAt        DateTime?               @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime                @map("created_at") @db.Timestamptz(3)
  office        Office                  @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  task          Task?                   @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deadline      JudicialDeadline?       @relation(fields: [deadlineId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, kind, targetId, referenceDate])
  @@index([officeId, userId, readAt, createdAt])
  @@index([emailStatus, nextAttemptAt])
  @@index([taskId])
  @@index([deadlineId])
  @@map("notifications")
}

enum DocumentCategory {
  CONTRACT
  POWER_OF_ATTORNEY
  PETITION
  DECISION
  EVIDENCE
  PERSONAL_DOCUMENT
  RECEIPT
  OTHER

  @@map("document_category")
}

model Document {
  id              String            @id @db.Uuid
  officeId        String            @map("office_id") @db.Uuid
  name            String            @db.VarChar(200)
  description     String            @default("") @db.VarChar(2000)
  category        DocumentCategory
  confidential    Boolean           @default(false)
  active          Boolean           @default(true)
  clientId        String?           @map("client_id") @db.Uuid
  caseId          String?           @map("case_id") @db.Uuid
  processId       String?           @map("process_id") @db.Uuid
  currentVersion  Int               @map("current_version")
  creatorId       String            @map("creator_id") @db.Uuid
  inactivatedAt   DateTime?         @map("inactivated_at") @db.Timestamptz(3)
  inactivatedById String?           @map("inactivated_by_id") @db.Uuid
  version         Int               @default(0)
  createdAt       DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @map("updated_at") @db.Timestamptz(3)
  office          Office            @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator         User              @relation("DocumentCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inactivatedBy   User?             @relation("DocumentInactivatedBy", fields: [inactivatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions        DocumentVersion[]
  events          DocumentEvent[]

  @@index([officeId, active, category, updatedAt])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  number       Int
  storageKey   String   @unique @map("storage_key") @db.VarChar(300)
  originalName String   @map("original_name") @db.VarChar(255)
  contentType  String   @map("content_type") @db.VarChar(120)
  sizeBytes    BigInt   @map("size_bytes")
  sha256       String   @db.Char(64)
  uploaderId   String   @map("uploader_id") @db.Uuid
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  document     Document @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([documentId, number])
  @@map("document_versions")
}

model DocumentEvent {
  id            String   @id @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  action        String   @db.VarChar(40)
  versionNumber Int?     @map("version_number")
  details       Json?
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)
  document      Document @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor         User     @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([documentId, createdAt])
  @@map("document_events")
}

enum ClientType {
  INDIVIDUAL
  LEGAL_ENTITY

  @@map("client_type")
}

enum ClientStatus {
  ACTIVE
  INACTIVE

  @@map("client_status")
}

model Client {
  id                      String                @id @db.Uuid
  officeId                String                @map("office_id") @db.Uuid
  type                    ClientType
  name                    String                @db.VarChar(150)
  socialName              String?               @map("social_name") @db.VarChar(150)
  documentNumber          String                @map("document_number") @db.VarChar(14)
  email                   String?               @db.VarChar(254)
  phone                   String?               @db.VarChar(20)
  addressZipCode          String?               @map("address_zip_code") @db.Char(8)
  addressStreet           String?               @map("address_street") @db.VarChar(160)
  addressNumber           String?               @map("address_number") @db.VarChar(20)
  addressComplement       String?               @map("address_complement") @db.VarChar(80)
  addressNeighborhood     String?               @map("address_neighborhood") @db.VarChar(80)
  addressCity             String?               @map("address_city") @db.VarChar(80)
  addressState            String?               @map("address_state") @db.Char(2)
  internalNotes           String?               @map("internal_notes") @db.Text
  responsibleMembershipId String?               @map("responsible_membership_id") @db.Uuid
  status                  ClientStatus          @default(ACTIVE)
  version                 Int                   @default(0)
  createdAt               DateTime              @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @map("updated_at") @db.Timestamptz(3)

  office                  Office                @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsibleMembership   Membership?           @relation("ClientResponsibleMembership", fields: [responsibleMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contacts                ClientContact[]
  timelineEvents          ClientTimelineEvent[]
  cases                   CaseClient[]

  @@unique([officeId, documentNumber])
  @@index([officeId, status, name])
  @@index([officeId, email])
  @@index([officeId, phone])
  @@index([officeId, responsibleMembershipId])
  @@map("clients")
}

model ClientContact {
  id             String   @id @db.Uuid
  officeId       String   @map("office_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  name           String   @db.VarChar(120)
  roleOrRelation String?  @map("role_or_relation") @db.VarChar(80)
  email          String?  @db.VarChar(254)
  phone          String?  @db.VarChar(20)
  notes          String?  @db.VarChar(500)
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  office         Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, clientId, createdAt])
  @@map("client_contacts")
}

model ClientTimelineEvent {
  id        String   @id @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String   @db.VarChar(40)
  previous  Json?
  current   Json
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  office    Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor     User     @relation("ClientTimelineActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, clientId, createdAt])
  @@map("client_timeline_events")
}

enum CaseNature {
  JUDICIAL
  EXTRAJUDICIAL
  ADMINISTRATIVE
  ADVISORY

  @@map("case_nature")
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("case_priority")
}

enum CaseStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED

  @@map("case_status")
}

enum ProcessRelationType {
  MAIN
  APPEAL
  INCIDENTAL
  EXECUTION

  @@map("process_relation_type")
}

enum ProcessInstance {
  FIRST_INSTANCE
  SECOND_INSTANCE
  SUPERIOR_COURT
  ADMINISTRATIVE

  @@map("process_instance")
}

model LegalCase {
  id                      String              @id @db.Uuid
  officeId                String              @map("office_id") @db.Uuid
  title                   String              @db.VarChar(160)
  description             String?             @db.Text
  nature                  CaseNature
  legalArea               String              @map("legal_area") @db.VarChar(40)
  priority                CasePriority        @default(MEDIUM)
  status                  CaseStatus          @default(ACTIVE)
  responsibleMembershipId String?             @map("responsible_membership_id") @db.Uuid
  claimAmountCents        BigInt?             @map("claim_amount_cents")
  involvedAmountCents     BigInt?             @map("involved_amount_cents")
  lastActivityAt          DateTime            @map("last_activity_at") @db.Timestamptz(3)
  version                 Int                 @default(0)
  createdAt               DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @map("updated_at") @db.Timestamptz(3)

  office                  Office              @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responsibleMembership   Membership?         @relation("CaseResponsibleMembership", fields: [responsibleMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  clients                 CaseClient[]
  teamMembers             CaseTeamMember[]
  parties                 CaseParty[]
  processes               LegalProcess[]
  movements               ProcessMovement[]
  timelineEvents          CaseTimelineEvent[]

  @@index([officeId, status, lastActivityAt])
  @@index([officeId, status, responsibleMembershipId])
  @@index([officeId, legalArea, status])
  @@index([officeId, priority, status])
  @@map("legal_cases")
}

model CaseClient {
  officeId  String    @map("office_id") @db.Uuid
  caseId    String    @map("case_id") @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)

  office    Office    @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalCase LegalCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([caseId, clientId])
  @@index([officeId, clientId])
  @@index([officeId, caseId])
  @@map("case_clients")
}

model CaseTeamMember {
  officeId     String     @map("office_id") @db.Uuid
  caseId       String     @map("case_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  createdAt    DateTime   @map("created_at") @db.Timestamptz(3)

  office       Office     @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalCase    LegalCase  @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([caseId, membershipId])
  @@index([officeId, membershipId])
  @@map("case_team_members")
}

model CaseParty {
  id             String    @id @db.Uuid
  officeId       String    @map("office_id") @db.Uuid
  caseId         String    @map("case_id") @db.Uuid
  partyRole      String    @map("party_role") @db.VarChar(40)
  name           String    @db.VarChar(150)
  documentNumber String?   @map("document_number") @db.VarChar(14)
  oab            String?   @db.VarChar(20)
  contactInfo    String?   @map("contact_info") @db.VarChar(200)
  notes          String?   @db.VarChar(500)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)

  office         Office    @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalCase      LegalCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, caseId, createdAt])
  @@map("case_parties")
}

model LegalProcess {
  id              String              @id @db.Uuid
  officeId        String              @map("office_id") @db.Uuid
  caseId          String              @map("case_id") @db.Uuid
  cnjNumber       String              @map("cnj_number") @db.Char(20)
  relationType    ProcessRelationType @default(MAIN) @map("relation_type")
  court           String              @db.VarChar(60)
  district        String?             @db.VarChar(120)
  chamber         String?             @db.VarChar(120)
  instance        ProcessInstance
  proceduralPhase String              @map("procedural_phase") @db.VarChar(40)
  version         Int                 @default(0)
  createdAt       DateTime            @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @map("updated_at") @db.Timestamptz(3)

  office          Office              @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalCase       LegalCase           @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements       ProcessMovement[]
  timelineEvents  CaseTimelineEvent[]

  @@unique([officeId, caseId, cnjNumber])
  @@index([officeId, cnjNumber])
  @@index([officeId, caseId, createdAt])
  @@map("legal_processes")
}

model ProcessMovement {
  id          String       @id @db.Uuid
  officeId    String       @map("office_id") @db.Uuid
  caseId      String       @map("case_id") @db.Uuid
  processId   String       @map("process_id") @db.Uuid
  actorId     String       @map("actor_id") @db.Uuid
  occurredAt  DateTime     @map("occurred_at") @db.Timestamptz(3)
  description String       @db.Text
  createdAt   DateTime     @map("created_at") @db.Timestamptz(3)

  office      Office       @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalCase   LegalCase    @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  process     LegalProcess @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor       User         @relation("ProcessMovementActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, processId, occurredAt])
  @@index([officeId, caseId, occurredAt])
  @@map("process_movements")
}

model CaseTimelineEvent {
  id        String        @id @db.Uuid
  officeId  String        @map("office_id") @db.Uuid
  caseId    String        @map("case_id") @db.Uuid
  processId String?       @map("process_id") @db.Uuid
  actorId   String        @map("actor_id") @db.Uuid
  action    String        @db.VarChar(40)
  previous  Json?
  current   Json
  createdAt DateTime      @map("created_at") @db.Timestamptz(3)

  office    Office        @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalCase LegalCase     @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  process   LegalProcess? @relation(fields: [processId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor     User          @relation("CaseTimelineActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([officeId, caseId, createdAt])
  @@index([officeId, processId, createdAt])
  @@map("case_timeline_events")
}

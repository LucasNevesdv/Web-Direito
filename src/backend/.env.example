# Illustrative local backend configuration; replace with your own values.
DATABASE_URL="postgresql://example_user:example_password@127.0.0.1:5432/example_database"
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
## Gere o segredo local com: pnpm --filter ./backend run configure:auth
## Em produção, forneça segredo aleatório próprio de pelo menos 32 bytes em base64url.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=neodireito
AUTH_JWT_AUDIENCE=neodireito-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800

{
  "name": "@legal-system/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "verify:office-repository": "tsx tests/integration/prisma-offices-repository.check.ts",
    "verify:onboarding": "tsx tests/integration/onboarding.check.ts",
    "configure:auth": "node scripts/configure-auth.mjs",
    "verify:auth-browser": "node tests/integration/authentication-browser.check.mjs",
    "verify:rate-limit": "node tests/integration/distributed-rate-limit.check.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11",
    "@prisma/client": "^6.16.2",
    "argon2": "0.44.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.0.0",
    "jose": "6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
